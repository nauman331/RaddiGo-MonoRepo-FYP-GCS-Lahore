# Base Dockerfile for BunJS microservices
FROM oven/bun:1.1-alpine AS base
WORKDIR /app

# Copy package.json and bun.lock for dependency caching
COPY package.json bun.lock* ./
COPY packages ./packages

# Install all dependencies (including workspaces)
RUN bun install --frozen-lockfile

# Production dependencies stage
FROM base AS prod-deps
ENV NODE_ENV=production
RUN bun install --frozen-lockfile --production

# Development stage
FROM base AS dev
ENV NODE_ENV=development
COPY apps ./apps
EXPOSE 3000
CMD ["bun", "run", "dev"]

# Build stage for production
FROM base AS build
ENV NODE_ENV=production
COPY apps ./apps
COPY tsconfig.json ./

# Production stage
FROM oven/bun:1.1-alpine AS production
WORKDIR /app
ENV NODE_ENV=production

# Copy production dependencies
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/packages ./packages

# Copy application code
COPY --from=build /app/apps ./apps
COPY --from=build /app/package.json ./
COPY --from=build /app/tsconfig.json ./

# Fix #11: Use addgroup/adduser (Alpine-compatible, NOT groupadd which is Debian-only)
RUN addgroup -S -g 1001 bungroup && adduser -S -u 1001 -G bungroup bunuser
USER bunuser

EXPOSE 3000

# Health check using bun (no curl needed)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bun -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "run", "start"]